API_PORT=3000

BCRYPT_SALTS=10

# use a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me
JWT_EXPIRES_IN=24h

# Streamable HTTP MCP endpoint at POST /mcp (bearer auth)
MCP_ENABLED=true
# JWT used by the stdio MCP server (`npm run mcp:token -- --email ... --password ...`)
MCP_ACCESS_TOKEN=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=crud
DB_USER=crud
DB_PASSWORD=crud
